@model List<Book>
<h2>Books</h2>
<a href="/Books/Create">Add New</a>
<table>
    <tr>
        <th>Title</th>
        <th>Author</th>
        <th>Year</th>
        <th>Actions</th>
    </tr>
    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Title</td>
            <td>@book.Author</td>
            <td>@book.Author</td>
            <td>@book.Year</td>
            <td>
                <a href="/Books/Edit/@book.Id">Edit</a> |
                <a href="/Books/Delete/@book.Id">Delete</a>
            </td>
        </tr>
    }
</table>
